# dependencies
node_modules/
.pnp
.pnp.js

# environment — broad match (covers .env, .env.local, .env.production, etc.) with an
# explicit exception for the committed placeholder file, so a future .env.<anything>
# can't be accidentally committed by not matching one of a few hardcoded suffixes.
.env*
!.env.example

# build output
dist/
build/
*.tsbuildinfo

# prisma
apps/api/prisma/dev.db
apps/api/generated/

# logs
npm-debug.log*
*.log
logs/

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# os
.DS_Store
Thumbs.db

# test/coverage
coverage/

# vite
apps/web/dist/
