# ==============================================================================
# Centurion Technical Assessment Platform — execution-service environment
# Copy this file to `.env` (in this same apps/execution-service directory).
# Never commit `.env`. See docs/coding-engine.md for the full design.
# ==============================================================================

NODE_ENV=development
# Internal-only — bound to 127.0.0.1, never exposed publicly.
PORT=4100

# In production this should be a dedicated, least-privileged `execution_service`
# Postgres role (docs/security.md §4) — grants limited to submissions/
# submission_test_results/execution_jobs (read+write) and coding_questions/
# coding_test_cases/coding_question_languages (read-only). Provisioning that role
# is a DBA/deployment step; in local dev it's fine to point this at the same
# database apps/api uses.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/technical_platform?schema=public

# Must exactly match apps/api's EXECUTION_SERVICE_SHARED_SECRET.
EXECUTION_SERVICE_SHARED_SECRET=replace-with-a-long-random-secret

POLL_INTERVAL_MS=500

# ---- Toolchain paths — never assumed to be on PATH (docs/architecture.md §0) ----
# C++: install MinGW-w64/MSYS2 (or run this service under WSL) and point this at
# the resulting g++ binary, e.g. CPP_COMPILER_PATH=C:\msys64\mingw64\bin\g++.exe
#
# IMPORTANT: install MinGW to a path with NO SPACES. A space anywhere in the
# compiler's own install path (e.g. under "OneDrive\Desktop\New folder\...")
# breaks g++'s internal collect2->ld handoff on Windows — collect2 passes the
# (space-containing) crt/library paths to ld.exe without quoting them, so ld
# sees a path truncated at the first space and fails with "cannot find
# <path up to the space>: No such file or directory". This happens purely
# inside gcc's own process chain — it reproduces identically whether g++ is
# invoked via its real path, a short 8.3 path, or an NTFS junction (all three
# resolve back to the same real path internally). Compiling alone (`g++ -c`)
# works fine either way; only the link step is affected. The only real fix is
# a compiler install whose own path has no spaces.
CPP_COMPILER_PATH=g++

# Java: leave JAVA_HOME set to your JDK install and javac/java are resolved
# from <JAVA_HOME>/bin automatically. Override JAVAC_PATH/JAVA_PATH directly
# if you'd rather not rely on JAVA_HOME.
# JAVA_HOME=C:\Program Files\Java\jdk-21
# JAVAC_PATH=
# JAVA_PATH=

# Python: this dev machine's `python3` is a Windows Store alias stub that does
# not run real Python — always invoke `python` (or an absolute path) instead.
PYTHON_PATH=python

COMPILE_TIMEOUT_MS=10000
RUNTIME_GRACE_MS=1000
MAX_OUTPUT_BYTES=1000000
MAX_STDIN_BYTES=1000000
MAX_JOB_ATTEMPTS=2
