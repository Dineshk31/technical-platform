// Prisma schema for the Centurion Technical Assessment Platform.
// Source of truth for the design: docs/database-schema.md.
//
// Deviation from that document (documented, not silent): UUID primary keys are
// generated by Prisma (`@default(uuid())`) rather than via the Postgres
// `gen_random_uuid()` function, so no database extension (pgcrypto) needs to
// be enabled by whoever installs PostgreSQL. Functionally equivalent.
//
// Phase 1 implements this full schema (it was already fully designed) but
// only builds NestJS modules/APIs for Roles/Users/Auth. Assessments,
// questions, submissions, AI generation, and results are modeled now so
// later phases are additive migrations, not a schema rework.

// Generated into a project-local folder (not node_modules/@prisma/client) so
// generation doesn't depend on how npm workspaces happens to hoist packages —
// see the note above prisma.config.ts for the rest of the Prisma 7 changes.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Prisma 7 no longer reads the connection string from the schema file — it comes
// from prisma.config.ts (for the CLI) and from a driver adapter passed to
// `new PrismaClient({ adapter })` at runtime (see src/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

// ================================================================
// Enums
// ================================================================

enum UserRoleCode {
  ADMIN
  STUDENT

  @@map("user_role_code")
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("assessment_status")
}

enum SectionType {
  CODING
  MCQ

  @@map("section_type")
}

enum QuestionType {
  CODING
  MCQ

  @@map("question_type")
}

enum QuestionSource {
  MANUAL
  AI_GENERATED

  @@map("question_source")
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  NEEDS_EDIT

  @@map("approval_status")
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD

  @@map("difficulty_level")
}

enum ProgrammingLanguage {
  CPP
  JAVA
  PYTHON

  @@map("programming_language")
}

enum McqType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  CODE_OUTPUT
  SCENARIO

  @@map("mcq_type")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED

  @@map("attempt_status")
}

enum SubmissionKind {
  RUN
  SUBMIT

  @@map("submission_kind")
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  INTERNAL_ERROR

  @@map("submission_status")
}

enum ExecutionJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED

  @@map("execution_job_status")
}

enum AiRequestStatus {
  PENDING
  SUCCESS
  FAILED

  @@map("ai_request_status")
}

enum ParticipantSource {
  DIRECT
  GROUP

  @@map("participant_source")
}

// ================================================================
// Identity & Roles
// ================================================================

model Role {
  id        String       @id @default(uuid()) @db.Uuid
  code      UserRoleCode @unique
  name      String
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  // id from the future Centurion platform / SSO; NULL until integrated — see docs/integration.md
  externalId   String?  @unique @map("external_id")
  // Stored lower-cased by the application layer; enforced unique here instead of via
  // the Postgres `citext` extension so no extra extension is required at install time.
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String
  roleId       String   @map("role_id") @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id])
  department   String?
  batch        String?
  isActive     Boolean  @default(true) @map("is_active")
  // Phase 13 — login brute-force protection (docs/security.md §1). Incremented on every
  // failed password check, reset to 0 on success; once it crosses the threshold the
  // account is time-locked via lockedUntil rather than permanently disabled.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdAssessments      Assessment[]            @relation("AssessmentCreatedBy")
  createdQuestions        Question[]              @relation("QuestionCreatedBy")
  aiGenerationRequests    AiGenerationRequest[]
  questionReviews         QuestionReview[]
  assessmentParticipation AssessmentParticipant[]
  attempts                Attempt[]
  results                 Result[]
  refreshTokens           RefreshToken[]

  @@index([roleId])
  @@index([department, batch])
  @@map("users")
}

/// Server-side record of issued refresh tokens (hashed), so a refresh token
/// can be individually revoked on logout instead of only expiring by TTL.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("refresh_tokens")
}

// ================================================================
// Question Bank (shared parent)
// ================================================================

model Question {
  id                     String         @id @default(uuid()) @db.Uuid
  type                   QuestionType
  title                  String
  difficulty             DifficultyLevel
  topics                 String[]       @default([])
  tags                   String[]       @default([])
  marks                  Decimal        @db.Decimal(6, 2)
  source                 QuestionSource @default(MANUAL)
  // Defense-in-depth: both real call sites (QuestionsService.create/createMcq) pass this
  // explicitly, but the schema-level default must itself be the safe value — a future
  // write path (bulk import, seed script, manual edit) that omits the field must not
  // silently create a live, unreviewed question. See docs/security.md §2.
  approvalStatus         ApprovalStatus @default(PENDING_REVIEW) @map("approval_status")
  createdById            String         @map("created_by") @db.Uuid
  createdBy              User           @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  aiGenerationRequestId  String?        @map("ai_generation_request_id") @db.Uuid
  aiGenerationRequest    AiGenerationRequest? @relation(fields: [aiGenerationRequestId], references: [id])
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  codingQuestion     CodingQuestion?
  mcqQuestion        McqQuestion?
  reviews            QuestionReview[]
  assessmentQuestions AssessmentQuestion[]

  @@index([type, approvalStatus])
  @@index([difficulty])
  @@index([topics], type: Gin)
  @@map("questions")
}

model CodingQuestion {
  questionId        String   @id @map("question_id") @db.Uuid
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  problemStatement  String   @map("problem_statement")
  inputFormat       String   @map("input_format")
  outputFormat      String   @map("output_format")
  constraints       String[] @default([])
  // [{ input, output, explanation }] — display-only, genuinely semi-structured (see docs/database-schema.md §1)
  examples          Json     @default("[]")
  timeLimitSeconds  Decimal  @default(2) @map("time_limit_seconds") @db.Decimal(5, 2)
  memoryLimitMb     Int      @default(256) @map("memory_limit_mb")

  languages          CodingQuestionLanguage[]
  referenceSolutions CodingReferenceSolution[]
  starterTemplates   CodingStarterTemplate[]
  testCases          CodingTestCase[]
  submissions        Submission[]
  codeDrafts         AttemptCodeDraft[]

  @@map("coding_questions")
}

model CodingQuestionLanguage {
  questionId String              @map("question_id") @db.Uuid
  question   CodingQuestion      @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  language   ProgrammingLanguage

  @@id([questionId, language])
  @@map("coding_question_languages")
}

model CodingReferenceSolution {
  id         String              @id @default(uuid()) @db.Uuid
  questionId String              @map("question_id") @db.Uuid
  question   CodingQuestion      @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  language   ProgrammingLanguage
  code       String

  @@unique([questionId, language])
  @@map("coding_reference_solutions")
}

/// Student-facing boilerplate shown before they write anything — deliberately a
/// separate model from CodingReferenceSolution (an admin-only, never-exposed
/// working solution). Reusing that table for starter code would leak the answer
/// to students; see docs/security.md. Optional per (question, language) — when
/// absent, the frontend falls back to a generic per-language template (see
/// packages/shared) rather than requiring every question to define one.
model CodingStarterTemplate {
  id         String              @id @default(uuid()) @db.Uuid
  questionId String              @map("question_id") @db.Uuid
  question   CodingQuestion      @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  language   ProgrammingLanguage
  code       String

  @@unique([questionId, language])
  @@map("coding_starter_templates")
}

model CodingTestCase {
  id             String         @id @default(uuid()) @db.Uuid
  questionId     String         @map("question_id") @db.Uuid
  question       CodingQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  isHidden       Boolean        @default(false) @map("is_hidden")
  input          String
  expectedOutput String         @map("expected_output")
  orderIndex     Int            @default(0) @map("order_index")
  // reserved for future partial-credit scoring; MVP scoring ignores it (all-or-nothing)
  weight         Decimal        @default(1) @db.Decimal(5, 2)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  submissionTestResults SubmissionTestResult[]

  @@index([questionId])
  @@map("coding_test_cases")
}

// ================================================================
// MCQ detail
// ================================================================

model McqQuestion {
  questionId            String   @id @map("question_id") @db.Uuid
  question              Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mcqType               McqType  @map("mcq_type")
  questionText          String   @map("question_text")
  codeSnippet           String?  @map("code_snippet")
  explanation           String?
  // default 0 = no negative marking; configurable per question
  negativeMarkingValue  Decimal  @default(0) @map("negative_marking_value") @db.Decimal(5, 2)

  options   McqOption[]
  responses McqResponse[]

  @@map("mcq_questions")
}

model McqOption {
  id         String      @id @default(uuid()) @db.Uuid
  questionId String      @map("question_id") @db.Uuid
  question   McqQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  optionText String      @map("option_text")
  isCorrect  Boolean     @default(false) @map("is_correct")
  orderIndex Int         @default(0) @map("order_index")

  responseSelections McqResponseOption[]

  @@index([questionId])
  @@map("mcq_options")
}

// ================================================================
// AI generation & review
// ================================================================

model AiGenerationRequest {
  id               String           @id @default(uuid()) @db.Uuid
  requestedById    String           @map("requested_by") @db.Uuid
  requestedBy      User             @relation(fields: [requestedById], references: [id])
  sectionType      QuestionType     @default(CODING) @map("section_type")
  topic            String
  difficulty       DifficultyLevel
  countRequested   Int              @map("count_requested")
  languageHint     ProgrammingLanguage? @map("language_hint")
  marksHint        Decimal?         @map("marks_hint") @db.Decimal(6, 2)
  timeLimitHint    Decimal?         @map("time_limit_hint") @db.Decimal(5, 2)
  memoryLimitHint  Int?             @map("memory_limit_hint")
  // exact prompt sent, for auditability/debugging
  promptSnapshot   String           @map("prompt_snapshot")
  // raw provider response, for audit; never surfaced to students
  rawResponse      Json?            @map("raw_response")
  status           AiRequestStatus  @default(PENDING)
  errorMessage     String?          @map("error_message")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(6)

  generatedQuestions Question[]

  @@map("ai_generation_requests")
}

model QuestionReview {
  id           String         @id @default(uuid()) @db.Uuid
  questionId   String         @map("question_id") @db.Uuid
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewedById String?        @map("reviewed_by") @db.Uuid
  reviewedBy   User?          @relation(fields: [reviewedById], references: [id])
  status       ApprovalStatus
  reviewNotes  String?        @map("review_notes")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([questionId])
  @@map("question_reviews")
}

// ================================================================
// Assessments
// ================================================================

model Assessment {
  id               String           @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  instructions     String?
  durationMinutes  Int              @map("duration_minutes")
  startAt          DateTime         @map("start_at") @db.Timestamptz(6)
  endAt            DateTime         @map("end_at") @db.Timestamptz(6)
  // denormalized sum, recomputed when questions attached
  maxMarks         Decimal          @default(0) @map("max_marks") @db.Decimal(7, 2)
  status           AssessmentStatus @default(DRAFT)
  createdById      String           @map("created_by") @db.Uuid
  createdBy        User             @relation("AssessmentCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  sections     AssessmentSection[]
  participants AssessmentParticipant[]
  attempts     Attempt[]
  results      Result[]

  @@index([status])
  @@index([startAt, endAt])
  @@map("assessments")
}

model AssessmentSection {
  id            String      @id @default(uuid()) @db.Uuid
  assessmentId  String      @map("assessment_id") @db.Uuid
  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  title         String
  sectionType   SectionType @map("section_type")
  orderIndex    Int         @default(0) @map("order_index")

  questions AssessmentQuestion[]

  @@index([assessmentId])
  @@map("assessment_sections")
}

model AssessmentQuestion {
  id             String            @id @default(uuid()) @db.Uuid
  sectionId      String            @map("section_id") @db.Uuid
  section        AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionId     String            @map("question_id") @db.Uuid
  question       Question          @relation(fields: [questionId], references: [id])
  // NULL = use questions.marks
  marksOverride  Decimal?          @map("marks_override") @db.Decimal(6, 2)
  orderIndex     Int               @default(0) @map("order_index")

  @@unique([sectionId, questionId])
  @@index([questionId])
  @@map("assessment_questions")
}

model AssessmentParticipant {
  id            String            @id @default(uuid()) @db.Uuid
  assessmentId  String            @map("assessment_id") @db.Uuid
  assessment    Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId        String            @map("user_id") @db.Uuid
  user          User              @relation(fields: [userId], references: [id])
  source        ParticipantSource @default(DIRECT)
  // e.g. "CSE-2026-A" if assigned via batch/department filter
  groupLabel    String?           @map("group_label")
  assignedAt    DateTime          @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@unique([assessmentId, userId])
  @@index([userId])
  @@map("assessment_participants")
}

// ================================================================
// Attempts & Submissions
// ================================================================

model Attempt {
  id            String        @id @default(uuid()) @db.Uuid
  assessmentId  String        @map("assessment_id") @db.Uuid
  assessment    Assessment    @relation(fields: [assessmentId], references: [id])
  userId        String        @map("user_id") @db.Uuid
  user          User          @relation(fields: [userId], references: [id])
  startedAt     DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  // computed server-side = min(started_at + duration, assessment.end_at) at start time
  endsAt        DateTime      @map("ends_at") @db.Timestamptz(6)
  submittedAt   DateTime?     @map("submitted_at") @db.Timestamptz(6)
  status        AttemptStatus @default(IN_PROGRESS)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  submissions   Submission[]
  mcqResponses  McqResponse[]
  codeDrafts    AttemptCodeDraft[]
  result        Result?

  @@unique([assessmentId, userId])
  @@index([userId])
  @@index([status, endsAt])
  @@map("attempts")
}

/// The student's current, continuously-overwritten code for one (attempt, question,
/// language) slot — Phase 5 scope: persistence only, never executed or scored. This is
/// deliberately NOT a Submission: a Submission is an immutable historical record of an
/// actual RUN/SUBMIT execution (docs/coding-engine.md), whereas a draft is mutable
/// editor state that only ever gets *read* by a future Phase 6/7 run/submit action (to
/// snapshot into a new Submission.code) — keeping the two concepts separate avoids
/// polluting submission history with saves that were never executed.
model AttemptCodeDraft {
  id         String              @id @default(uuid()) @db.Uuid
  attemptId  String              @map("attempt_id") @db.Uuid
  attempt    Attempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String              @map("question_id") @db.Uuid
  question   CodingQuestion      @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  language   ProgrammingLanguage
  code       String
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([attemptId, questionId, language])
  @@index([attemptId])
  @@map("attempt_code_drafts")
}

model Submission {
  id            String            @id @default(uuid()) @db.Uuid
  attemptId     String            @map("attempt_id") @db.Uuid
  attempt       Attempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String            @map("question_id") @db.Uuid
  question      CodingQuestion    @relation(fields: [questionId], references: [questionId])
  kind          SubmissionKind
  language      ProgrammingLanguage
  code          String
  status        SubmissionStatus  @default(PENDING)
  score         Decimal           @default(0) @db.Decimal(6, 2)
  testsPassed   Int               @default(0) @map("tests_passed")
  testsTotal    Int               @default(0) @map("tests_total")
  runtimeMs     Int?              @map("runtime_ms")
  memoryKb      Int?              @map("memory_kb")
  // compiler/runtime error, sanitized before returning to student
  errorMessage  String?           @map("error_message")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime?         @map("completed_at") @db.Timestamptz(6)

  testResults   SubmissionTestResult[]
  executionJob  ExecutionJob?

  @@index([attemptId, questionId])
  @@index([status])
  @@map("submissions")
}

model SubmissionTestResult {
  id            String         @id @default(uuid()) @db.Uuid
  submissionId  String         @map("submission_id") @db.Uuid
  submission    Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId    String         @map("test_case_id") @db.Uuid
  testCase      CodingTestCase @relation(fields: [testCaseId], references: [id])
  // denormalized for fast student-facing filtering
  isHidden      Boolean        @map("is_hidden")
  passed        Boolean
  // per-test-case verdict (reuses SubmissionStatus — PENDING/RUNNING never apply here);
  // the submission-level `status` is still the worst-case rollup used for authorization
  // and history, this is what lets the API tell a WRONG_ANSWER apart from a
  // TIME_LIMIT_EXCEEDED for one specific test case without re-parsing errorMessage text.
  status        SubmissionStatus @default(PENDING)
  // only returned to student when isHidden = false
  actualOutput  String?        @map("actual_output")
  runtimeMs     Int?           @map("runtime_ms")
  memoryKb      Int?           @map("memory_kb")
  errorMessage  String?        @map("error_message")
  orderIndex    Int            @default(0) @map("order_index")

  @@index([submissionId])
  @@map("submission_test_results")
}

/// Job queue row consumed by the standalone execution-service (see docs/coding-engine.md).
/// The API only ever inserts/reads this row — it never executes code itself.
model ExecutionJob {
  id            String             @id @default(uuid()) @db.Uuid
  submissionId  String             @unique @map("submission_id") @db.Uuid
  submission    Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status        ExecutionJobStatus @default(QUEUED)
  attemptCount  Int                @default(0) @map("attempt_count")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt     DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?          @map("completed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("execution_jobs")
}

// ================================================================
// MCQ responses
// ================================================================

model McqResponse {
  id          String      @id @default(uuid()) @db.Uuid
  attemptId   String      @map("attempt_id") @db.Uuid
  attempt     Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String      @map("question_id") @db.Uuid
  question    McqQuestion @relation(fields: [questionId], references: [questionId])
  isCorrect   Boolean?    @map("is_correct")
  score       Decimal     @default(0) @db.Decimal(6, 2)
  answeredAt  DateTime    @default(now()) @map("answered_at") @db.Timestamptz(6)

  selectedOptions McqResponseOption[]

  @@unique([attemptId, questionId])
  @@map("mcq_responses")
}

model McqResponseOption {
  responseId String      @map("response_id") @db.Uuid
  response   McqResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  optionId   String      @map("option_id") @db.Uuid
  option     McqOption   @relation(fields: [optionId], references: [id])

  @@id([responseId, optionId])
  @@map("mcq_response_options")
}

// ================================================================
// Results
// ================================================================

model Result {
  id                  String     @id @default(uuid()) @db.Uuid
  attemptId           String     @unique @map("attempt_id") @db.Uuid
  attempt             Attempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentId        String     @map("assessment_id") @db.Uuid
  assessment          Assessment @relation(fields: [assessmentId], references: [id])
  userId              String     @map("user_id") @db.Uuid
  user                User       @relation(fields: [userId], references: [id])
  totalScore          Decimal    @default(0) @map("total_score") @db.Decimal(7, 2)
  maxScore            Decimal    @default(0) @map("max_score") @db.Decimal(7, 2)
  percentage          Decimal    @default(0) @db.Decimal(5, 2)
  codingScore         Decimal    @default(0) @map("coding_score") @db.Decimal(7, 2)
  mcqScore            Decimal    @default(0) @map("mcq_score") @db.Decimal(7, 2)
  questionsAttempted  Int        @default(0) @map("questions_attempted")
  // used as tie-break #2 (more coding problems fully solved) — see docs/assessment-system.md
  questionsSolved     Int        @default(0) @map("questions_solved")
  // used as tie-break #3 (lower total time taken)
  timeTakenSeconds    Int        @default(0) @map("time_taken_seconds")
  submissionCount     Int        @default(0) @map("submission_count")
  // recomputed per-assessment on finalize; nullable until then
  rank                Int?
  finalizedAt         DateTime   @default(now()) @map("finalized_at") @db.Timestamptz(6)

  @@index([assessmentId, rank])
  @@index([userId])
  @@map("results")
}
