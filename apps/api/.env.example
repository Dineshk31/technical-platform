# ==============================================================================
# Centurion Technical Assessment Platform — API environment configuration
# Copy this file to `.env` (in this same apps/api directory) and fill in real
# values. Never commit `.env`. This file is read both by NestJS (ConfigModule,
# default cwd-relative lookup) and by the Prisma CLI (migrate/generate/seed/
# studio, which also defaults to the .env next to prisma/schema.prisma) —
# keeping one file here means both always see the same values.
# ==============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database (PostgreSQL, no Docker — see docs/database-schema.md) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/technical_platform?schema=public

# ---- Auth (generate your own secrets, e.g. `openssl rand -base64 48`) ----
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_TTL=7d

# ---- CORS / frontend origin ----
FRONTEND_URL=http://localhost:5173

# ---- Seed data (development only — used by `npm run prisma:seed`) ----
# Leave a password unset to skip creating that seed account.
SEED_ADMIN_EMAIL=admin@centurion.test
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=student@centurion.test
SEED_STUDENT_PASSWORD=

# ---- Execution service (Phase 6 — see docs/coding-engine.md) ----
# Must exactly match apps/execution-service's own EXECUTION_SERVICE_SHARED_SECRET.
EXECUTION_SERVICE_URL=http://127.0.0.1:4100
EXECUTION_SERVICE_SHARED_SECRET=replace-with-a-long-random-secret
# No more than one Run/Submit per student per question within this window
# (docs/security.md §7) — stops a scripted flood from starving the execution queue.
RUN_RATE_LIMIT_MS=2000

# ---- Reserved for later phases (do not use yet) ----
# GEMINI_API_KEY=                        # Phase 9 — AI question generation
