{
  "name": "@technical-platform/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared TypeScript types, enums, and Zod schemas used by the API and web app",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
